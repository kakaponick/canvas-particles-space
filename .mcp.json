{
  "mcpServers": {
    "chrome-devtools": {
      "command": "cmd",
      "args": [
        "/c", "npx", "-y", "chrome-devtools-mcp@1",
        "--headless",
        "--viewport", "1600x900",
        "--chromeArg=--use-angle=d3d11",
        "--chromeArg=--ignore-gpu-blocklist",
        "--chromeArg=--disable-backgrounding-occluded-windows",
        "--chromeArg=--disable-renderer-backgrounding",
        "--chromeArg=--disable-background-timer-throttling",
        "--screenshotFormat", "jpeg",
        "--screenshotQuality", "85",
        "--screenshotMaxWidth", "1600",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--no-page-id-routing"
      ]
    },
    "space": {
      "command": "node",
      "args": ["mcp/space_mcp.mjs"]
    }
  }
}
