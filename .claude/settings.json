{
  "env": {
    "POSTIZ_API_URL": "https://postiz.xn--c6t.net/api"
  },
  "skillOverrides": {
    "evolve": "off",
    "fsloop": "off",
    "fsloop-audit": "off"
  },
  "permissions": {
    "deny": [
      "Agent(fsloop-critic)",
      "Agent(fsloop-debug)",
      "Agent(fsloop-implement)",
      "Agent(fsloop-shots)",
      "Agent(shots-proof)",
      "Agent(spike-researcher)",
      "Agent(prod-check)",
      "Agent(cold-read)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/earlier_films.mjs\"",
            "shell": "bash",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/review_gate.mjs\"",
            "shell": "bash",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/earlier_films.mjs\"",
            "shell": "bash",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/review_gate.mjs\"",
            "shell": "bash",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/earlier_films.mjs\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
